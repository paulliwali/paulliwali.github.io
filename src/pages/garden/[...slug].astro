---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  const dailyNotes = await getCollection('daily-notes');

  return [
    ...blogPosts.map((post) => ({
      params: { slug: post.data.slug || post.id.split('/')[0] },
      props: { entry: post, type: 'blog' },
    })),
    ...dailyNotes.map((note) => ({
      params: { slug: note.id },
      props: { entry: note, type: 'daily' },
    })),
  ];
}

const { entry, type } = Astro.props;
const { Content } = await render(entry);
const currentSlug = type === 'blog' ? entry.data.slug || entry.id.split('/')[0] : entry.id;
const date = entry.data.date || entry.id.match(/(\d{4}-\d{2}-\d{2})/)?.[0] || '';
const title = entry.data.title || entry.id.split('/').pop()?.replace('.md', '') || 'Untitled';

// Find connected posts & slip-box notes so readers can traverse the knowledge graph directly
const allBlogPosts = await getCollection('blog');
const allNotes = await getCollection('notes');
const entryTags = new Set((entry.data.tags || []).map((t) => t.toLowerCase()));

interface ConnectedItem {
  url: string;
  title: string;
  surface: string;
  date?: string;
}

const connectedMap = new Map<string, ConnectedItem>();

for (const post of allBlogPosts) {
  const postSlug = post.data.slug || post.id.split('/')[0];
  if (postSlug === currentSlug) continue;
  const sharesTag = post.data.tags.some((t) => entryTags.has(t.toLowerCase()));
  const bodyLower = (post.body || '').toLowerCase();
  const hasLink =
    bodyLower.includes(`/garden/${currentSlug.toLowerCase()}`) ||
    bodyLower.includes(`[[${title.toLowerCase()}`);

  if (hasLink || sharesTag) {
    const url = `/garden/${postSlug}`;
    connectedMap.set(url, {
      url,
      title: post.data.title,
      surface: 'Garden',
      date: post.data.date,
    });
  }
}

for (const note of allNotes) {
  const noteTitle = note.data.title || note.id.split('/').pop()?.replace('.md', '') || 'Untitled';
  const bodyLower = (note.body || '').toLowerCase();
  const hasLink =
    bodyLower.includes(`/garden/${currentSlug.toLowerCase()}`) ||
    bodyLower.includes(`[[${title.toLowerCase()}`) ||
    bodyLower.includes(`[[${currentSlug.toLowerCase()}`);
  const sharesTag = note.data.tags.some((t) => entryTags.has(t.toLowerCase()));

  if (hasLink || sharesTag) {
    const url = `/slip-box/${note.id}`;
    connectedMap.set(url, { url, title: noteTitle, surface: 'Slip-Box' });
  }
}

const connectedItems = Array.from(connectedMap.values())
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''))
  .slice(0, 6);
---

<BaseLayout title={`${title} - Paul's Second Brain`} description={title}>
  <article class="blog-post">
    <header class="post-header">
      <h1>{title}</h1>
      {date && (
        <div class="post-meta">
          <time datetime={date}>{date}</time>
        </div>
      )}
      {entry.data.tags.length > 0 && (
        <div class="post-tags">
          {entry.data.tags.map((tag) => (
            <a href={`/garden?tag=${tag}`} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class="post-content">
      <Content />
    </div>

    {connectedItems.length > 0 && (
      <aside class="connected-notes">
        <h3>Connected in the Graph</h3>
        <ul class="connected-list">
          {connectedItems.map((item) => (
            <li>
              <a href={item.url}>{item.title}</a>
              <span class="surface-badge">{item.surface}</span>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <footer class="post-footer">
      <a href="/garden" class="back-link">← Back to Garden</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: 680px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .post-header h1 {
    margin-bottom: var(--spacing-md);
    font-size: 2.5rem;
  }

  .post-meta {
    display: flex;
    gap: var(--spacing-sm);
    align-items: center;
    flex-wrap: wrap;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-md);
  }

  .post-meta time {
    font-family: var(--font-mono);
  }

  .post-tags {
    display: flex;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    padding: 0.3em 0.7em;
    background-color: var(--color-bg-secondary-translucent);
    color: var(--color-text-secondary);
    border-radius: var(--border-radius);
    border: 1px solid var(--color-border);
  }

  .tag:hover {
    background-color: var(--color-accent-sage);
    color: white;
    border-color: var(--color-accent-sage);
  }

  .post-content {
    margin-bottom: var(--spacing-xl);
  }

  /* Enhanced content styles for blog posts */
  .post-content :global(h2) {
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }

  .post-content :global(h3) {
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
  }

  .post-content :global(p) {
    margin-bottom: var(--spacing-md);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: var(--spacing-md);
  }

  .post-content :global(li) {
    margin-bottom: var(--spacing-xs);
  }

  .post-content :global(blockquote) {
    margin: var(--spacing-lg) 0;
    padding-left: var(--spacing-md);
    border-left: 3px solid var(--color-accent-sage);
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .post-content :global(img) {
    margin: var(--spacing-lg) 0;
    border-radius: var(--border-radius);
  }

  .post-content :global(pre) {
    margin: var(--spacing-lg) 0;
  }

  .post-content :global(hr) {
    margin: var(--spacing-xl) 0;
  }

  .connected-notes {
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-lg);
    padding: var(--spacing-md);
    background-color: var(--color-bg-secondary-translucent);
    border-radius: var(--border-radius);
    border-left: 3px solid var(--color-accent-sage);
  }

  .connected-notes h3 {
    margin: 0 0 var(--spacing-sm) 0;
    font-size: 1.05rem;
    color: var(--color-accent-sage);
  }

  .connected-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .connected-list li {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-xs);
  }

  .connected-list a {
    font-family: var(--font-heading);
    font-size: 0.95rem;
  }

  .surface-badge {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    color: var(--color-text-secondary);
    opacity: 0.8;
  }

  .post-footer {
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-family: var(--font-heading);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .post-header h1 {
      font-size: 2rem;
    }

    .post-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-xs);
    }
  }
</style>
