---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

// Get title from frontmatter or filename
const title = note.data.title || note.id.split('/').pop()?.replace('.md', '') || 'Untitled';

// Cross-surface graph connections (Slip-Box notes + Garden posts)
const allNotes = await getCollection('notes');
const allBlogPosts = await getCollection('blog');
const noteFileName = (note.id.split('/').pop()?.replace('.md', '') || '').toLowerCase();
const noteTags = new Set(note.data.tags.map((t) => t.toLowerCase()));

interface ConnectedEntry {
  url: string;
  title: string;
  surface: string;
}

const connectedMap = new Map<string, ConnectedEntry>();
const currentFolgezettel = title.match(/^(\d+[a-z]+(?:\d+[a-z]*)*)\b/i)?.[1]?.toLowerCase() || '';

function isFolgezettelNeighbor(codeA: string, codeB: string): boolean {
  if (!codeA || !codeB || codeA === codeB) return false;
  if (codeA.slice(0, -1) === codeB || codeB.slice(0, -1) === codeA) return true;
  if (
    codeA.length === codeB.length &&
    codeA.slice(0, -1) === codeB.slice(0, -1) &&
    Math.abs(codeA.charCodeAt(codeA.length - 1) - codeB.charCodeAt(codeB.length - 1)) === 1
  ) {
    return true;
  }
  return false;
}

for (const otherNote of allNotes) {
  if (otherNote.id === note.id) continue;
  const otherTitle = otherNote.data.title || otherNote.id.split('/').pop()?.replace('.md', '') || 'Untitled';
  const otherFolgezettel = otherTitle.match(/^(\d+[a-z]+(?:\d+[a-z]*)*)\b/i)?.[1]?.toLowerCase() || '';
  const bodyLower = (otherNote.body || '').toLowerCase();
  const hasWikilink =
    (noteFileName && bodyLower.includes(`[[${noteFileName}`)) ||
    bodyLower.includes(`[[${title.toLowerCase()}`);
  const sharesTag = otherNote.data.tags.some((t) => noteTags.has(t.toLowerCase()));
  const isFolgezettel = isFolgezettelNeighbor(currentFolgezettel, otherFolgezettel);

  if (hasWikilink || sharesTag || isFolgezettel) {
    const url = `/slip-box/${otherNote.id}`;
    connectedMap.set(url, { url, title: otherTitle, surface: 'Slip-Box' });
  }
}

for (const post of allBlogPosts) {
  const postSlug = post.data.slug || post.id.split('/')[0];
  const postUrl = `/garden/${postSlug}`;
  const bodyLower = (post.body || '').toLowerCase();
  const hasLink =
    (noteFileName && bodyLower.includes(`[[${noteFileName}`)) ||
    bodyLower.includes(`[[${title.toLowerCase()}`) ||
    bodyLower.includes(`/slip-box/${note.id.toLowerCase()}`);
  const sharesTag = post.data.tags.some((t) => noteTags.has(t.toLowerCase()));

  if (hasLink || sharesTag) {
    connectedMap.set(postUrl, { url: postUrl, title: post.data.title, surface: 'Garden' });
  }
}

const connectedEntries = Array.from(connectedMap.values()).slice(0, 8);
---

<BaseLayout title={`${title} - Slip-Box`} description={title}>
  <article class="note">
    <header class="note-header">
      <nav class="breadcrumb">
        <a href="/slip-box">Slip-Box</a>
        {note.id.includes('/') && (
          <>
            <span class="separator">/</span>
            <span class="folder">{note.id.split('/')[0].replace(/-/g, ' ')}</span>
          </>
        )}
      </nav>

      <h1>{title}</h1>

      {note.data.tags.length > 0 && (
        <div class="note-tags">
          {note.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="note-content">
      <Content />
    </div>

    {connectedEntries.length > 0 && (
      <aside class="backlinks">
        <h3>Connected Notes</h3>
        <ul class="backlinks-list">
          {connectedEntries.map((item) => (
            <li>
              <a href={item.url}>{item.title}</a>
              <span class="surface-badge">{item.surface}</span>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <footer class="note-footer">
      <a href="/slip-box" class="back-link">← Back to Slip-Box</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .note {
    max-width: 680px;
    margin: 0 auto;
  }

  .note-header {
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-md);
  }

  .breadcrumb a {
    color: var(--color-link);
  }

  .separator {
    margin: 0 var(--spacing-xs);
  }

  .folder {
    color: var(--color-accent-sage);
    text-transform: capitalize;
  }

  .note-header h1 {
    margin-bottom: var(--spacing-md);
    font-size: 2.5rem;
  }

  .note-tags {
    display: flex;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    padding: 0.3em 0.7em;
    background-color: var(--color-bg-secondary-translucent);
    color: var(--color-text-secondary);
    border-radius: var(--border-radius);
    border: 1px solid var(--color-border);
  }

  .note-content {
    margin-bottom: var(--spacing-xl);
  }

  .note-content :global(h2) {
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }

  .note-content :global(h3) {
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
  }

  .note-content :global(p) {
    margin-bottom: var(--spacing-md);
  }

  .note-content :global(ul),
  .note-content :global(ol) {
    margin-bottom: var(--spacing-md);
  }

  .note-content :global(blockquote) {
    margin: var(--spacing-lg) 0;
    padding-left: var(--spacing-md);
    border-left: 3px solid var(--color-accent-lavender);
    color: var(--color-text-secondary);
  }

  .note-content :global(code) {
    background-color: var(--color-bg-secondary);
  }

  .backlinks {
    margin-top: var(--spacing-xl);
    padding: var(--spacing-md);
    background-color: var(--color-bg-secondary-translucent);
    border-radius: var(--border-radius);
    border-left: 3px solid var(--color-accent-terracotta);
  }

  .backlinks h3 {
    margin: 0 0 var(--spacing-md) 0;
    font-size: 1.1rem;
    color: var(--color-accent-terracotta);
  }

  .backlinks-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .backlinks-list li {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-xs);
  }

  .backlinks-list a {
    font-family: var(--font-heading);
    font-size: 0.95rem;
  }

  .surface-badge {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    color: var(--color-text-secondary);
    opacity: 0.8;
  }

  .note-footer {
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border);
    margin-top: var(--spacing-xl);
  }

  .back-link {
    font-family: var(--font-heading);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .note-header h1 {
      font-size: 2rem;
    }
  }
</style>
